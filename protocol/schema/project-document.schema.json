{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiomengine.dev/schema/project-document-v1.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "revision",
    "scene"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^project://[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "scene": {
      "type": "object",
      "required": [
        "schemaVersion",
        "id",
        "entities"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^scene://[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "entities": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "transform"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^entity://[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "transform": {
                "type": "object",
                "required": [
                  "position",
                  "rotation",
                  "scale"
                ],
                "properties": {
                  "position": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number",
                      "minimum": -1000000,
                      "maximum": 1000000
                    }
                  },
                  "rotation": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {
                      "type": "number",
                      "minimum": -1000000,
                      "maximum": 1000000
                    }
                  },
                  "scale": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number",
                      "minimum": -1000000,
                      "maximum": 1000000
                    }
                  }
                }
              },
              "renderable": {
                "type": "object",
                "required": [
                  "assetId",
                  "kind"
                ],
                "properties": {
                  "assetId": {
                    "type": "string",
                    "pattern": "^asset://[0-9a-f]{64}$"
                  },
                  "kind": {
                    "enum": [
                      "sprite",
                      "mesh"
                    ]
                  }
                }
              }
            }
          }
        },
        "assets": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^asset://[0-9a-f]{64}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "kind": {
                "enum": [
                  "sprite",
                  "mesh",
                  "audio"
                ]
              },
              "sourceId": {
                "type": "string",
                "pattern": "^asset://[0-9a-f]{64}$"
              },
              "textureId": {
                "type": "string",
                "pattern": "^asset://[0-9a-f]{64}$"
              },
              "buildKey": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "camera": {
          "type": "object",
          "required": [
            "projection",
            "position",
            "target",
            "orthoHeight",
            "fov"
          ],
          "properties": {
            "projection": {
              "enum": [
                "perspective",
                "orthographic"
              ]
            },
            "position": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              }
            },
            "target": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              }
            },
            "orthoHeight": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 10000
            },
            "fov": {
              "type": "number",
              "minimum": 5,
              "maximum": 150
            }
          }
        },
        "assetDbVersion": {
          "const": 1
        }
      }
    }
  }
}
