{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiomengine.dev/schema/event-v1.json",
  "title": "Axiom Event v1",
  "type": "object",
  "required": [
    "type",
    "sequence",
    "data"
  ],
  "properties": {
    "type": {
      "enum": [
        "system.pong",
        "demo.counterChanged",
        "editor.commandUndone",
        "project.created",
        "project.opened",
        "project.saved",
        "project.listed",
        "scene.snapshot",
        "scene.entityCreated",
        "scene.entityUpdated",
        "scene.entityDeleted",
        "scene.undone",
        "scene.redone",
        "scene.saved",
        "asset.imported",
        "asset.loaded",
        "scene.assetPlaced",
        "scene.cameraChanged",
        "play.started",
        "play.stopped",
        "project.closed"
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "data": {
      "type": "object"
    },
    "reasonCode": {
      "type": "string",
      "pattern": "^AX_[A-Z]+_[0-9]{4}$"
    }
  }
}
