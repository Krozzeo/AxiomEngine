{
  "name": "axiom-engine",
  "version": "0.0.14",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build-editor.mjs",
    "predev": "npm run build",
    "dev": "node daemon/bootstrap/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:daemon-parity": "node scripts/check-daemon-parity.mjs",
    "check:schema": "node scripts/check-schemas.mjs",
    "doctor": "node scripts/doctor.mjs",
    "dev:native": "npm run build && cargo run -p axiom-daemon",
    "check:native": "cargo fmt --check && cargo clippy --locked --workspace --all-targets -- -D warnings && cargo test --locked --workspace",
    "check": "npm run build && npm run check:bindings && npm run check:schema && npm run check:architecture && npm run check:daemon-parity && npm test",
    "test:browser": "node tests/browser/m2.mjs && node tests/browser/m3.mjs",
    "check:bindings": "node scripts/generate-script-bindings.mjs --check",
    "test:browser:m4": "node tests/browser/m4.mjs"
  },
  "dependencies": {
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
