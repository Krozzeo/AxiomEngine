{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiomengine.dev/schema/project-document-v1.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "revision",
    "scene"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^project://[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "scene": {
      "type": "object",
      "required": [
        "schemaVersion",
        "id",
        "entities"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^scene://[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "entities": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "transform"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^entity://[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "transform": {
                "type": "object",
                "required": [
                  "position",
                  "rotation",
                  "scale"
                ],
                "properties": {
                  "position": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number",
                      "minimum": -1000000,
                      "maximum": 1000000
                    }
                  },
                  "rotation": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {
                      "type": "number",
                      "minimum": -1000000,
                      "maximum": 1000000
                    }
                  },
                  "scale": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number",
                      "minimum": -1000000,
                      "maximum": 1000000
                    }
                  }
                }
              },
              "renderable": {
                "type": "object",
                "required": [
                  "assetId",
                  "kind"
                ],
                "properties": {
                  "assetId": {
                    "type": "string",
                    "pattern": "^asset://[0-9a-f]{64}$"
                  },
                  "kind": {
                    "enum": [
                      "sprite",
                      "mesh"
                    ]
                  }
                }
              },
              "collider": {
                "type": "object",
                "required": [
                  "dimension",
                  "shape",
                  "halfExtents",
                  "trigger",
                  "layer",
                  "mask"
                ],
                "properties": {
                  "dimension": {
                    "type": "integer",
                    "enum": [
                      2,
                      3
                    ]
                  },
                  "shape": {
                    "type": "string",
                    "enum": [
                      "box",
                      "sphere"
                    ]
                  },
                  "halfExtents": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number",
                      "minimum": 0.001,
                      "maximum": 10000
                    }
                  },
                  "trigger": {
                    "type": "boolean"
                  },
                  "layer": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4294967295
                  },
                  "mask": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  }
                }
              },
              "rigidBody": {
                "type": "object",
                "required": [
                  "mass",
                  "velocity",
                  "restitution",
                  "friction",
                  "gravityScale"
                ],
                "properties": {
                  "mass": {
                    "type": "number",
                    "minimum": 0.001,
                    "maximum": 1000000
                  },
                  "velocity": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number",
                      "minimum": -10000,
                      "maximum": 10000
                    }
                  },
                  "restitution": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "friction": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "gravityScale": {
                    "type": "number",
                    "minimum": -100,
                    "maximum": 100
                  },
                  "angularVelocity": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number",
                      "minimum": -10000,
                      "maximum": 10000
                    }
                  },
                  "freezeRotation": {
                    "type": "boolean"
                  }
                }
              },
              "material": {
                "type": "object",
                "properties": {
                  "baseColor": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "metallic": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "roughness": {
                    "type": "number",
                    "minimum": 0.045,
                    "maximum": 1
                  },
                  "emissive": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 10000
                    }
                  },
                  "alphaMode": {
                    "type": "string",
                    "enum": [
                      "opaque",
                      "mask",
                      "blend"
                    ]
                  },
                  "alphaCutoff": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "unlit": {
                    "type": "boolean"
                  },
                  "castShadow": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "baseColor",
                  "metallic",
                  "roughness",
                  "emissive",
                  "alphaMode",
                  "alphaCutoff",
                  "unlit",
                  "castShadow"
                ]
              },
              "light": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "directional",
                      "point",
                      "spot"
                    ]
                  },
                  "color": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "intensity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 10000
                  },
                  "range": {
                    "type": "number",
                    "minimum": 0.01,
                    "maximum": 10000
                  },
                  "direction": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number",
                      "minimum": -1,
                      "maximum": 1
                    }
                  },
                  "innerAngle": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 89
                  },
                  "outerAngle": {
                    "type": "number",
                    "minimum": 0.1,
                    "maximum": 89
                  },
                  "shadow": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "kind",
                  "color",
                  "intensity",
                  "range",
                  "direction",
                  "innerAngle",
                  "outerAngle",
                  "shadow"
                ]
              },
              "lod": {
                "type": "object",
                "properties": {
                  "levels": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 3,
                    "items": {
                      "type": "object",
                      "properties": {
                        "assetId": {
                          "type": "string",
                          "pattern": "^asset://[0-9a-f]{64}$"
                        },
                        "distance": {
                          "type": "number",
                          "minimum": 0.01,
                          "maximum": 10000
                        }
                      },
                      "required": [
                        "assetId",
                        "distance"
                      ]
                    }
                  }
                },
                "required": [
                  "levels"
                ]
              },
              "parentId": {
                "type": "string",
                "pattern": "^entity://[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            }
          }
        },
        "assets": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^asset://[0-9a-f]{64}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "kind": {
                "enum": [
                  "sprite",
                  "mesh",
                  "audio"
                ]
              },
              "sourceId": {
                "type": "string",
                "pattern": "^asset://[0-9a-f]{64}$"
              },
              "textureId": {
                "type": "string",
                "pattern": "^asset://[0-9a-f]{64}$"
              },
              "buildKey": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "camera": {
          "type": "object",
          "required": [
            "projection",
            "position",
            "target",
            "orthoHeight",
            "fov"
          ],
          "properties": {
            "projection": {
              "enum": [
                "perspective",
                "orthographic"
              ]
            },
            "position": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              }
            },
            "target": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              }
            },
            "orthoHeight": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 10000
            },
            "fov": {
              "type": "number",
              "minimum": 5,
              "maximum": 150
            }
          }
        },
        "assetDbVersion": {
          "const": 1
        },
        "script": {
          "type": "object",
          "required": [
            "source",
            "attachments",
            "build"
          ],
          "properties": {
            "source": {
              "type": "string",
              "maxLength": 65536
            },
            "attachments": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string",
                "pattern": "^entity://[0-9a-f-]{36}$"
              }
            },
            "build": {
              "type": "object",
              "required": [
                "id",
                "sourceHash",
                "mode"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "sourceHash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "development",
                    "aot"
                  ]
                }
              }
            }
          }
        },
        "rendering": {
          "type": "object",
          "properties": {
            "tier": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "culling": {
              "type": "string",
              "enum": [
                "cpu",
                "gpu",
                "none"
              ]
            },
            "exposure": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 100
            },
            "toneMapping": {
              "type": "string",
              "enum": [
                "aces",
                "reinhard",
                "none"
              ]
            },
            "environment": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            },
            "shadows": {
              "type": "boolean"
            },
            "shadowSize": {
              "type": "number",
              "minimum": 1,
              "maximum": 100
            },
            "bloom": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "fxaa": {
              "type": "boolean"
            }
          },
          "required": [
            "tier",
            "culling",
            "exposure",
            "toneMapping",
            "environment",
            "shadows",
            "shadowSize",
            "bloom",
            "fxaa"
          ]
        }
      }
    },
    "editor": {
      "type": "object",
      "required": [
        "leftWidth",
        "rightWidth",
        "bottomHeight"
      ],
      "properties": {
        "leftWidth": {
          "type": "number",
          "minimum": 150,
          "maximum": 600
        },
        "rightWidth": {
          "type": "number",
          "minimum": 220,
          "maximum": 700
        },
        "bottomHeight": {
          "type": "number",
          "minimum": 120,
          "maximum": 650
        }
      }
    }
  }
}
