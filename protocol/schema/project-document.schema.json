                  },
                  "trigger": {
                    "type": "boolean"
                  },
                  "layer": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4294967295
                  },
                  "mask": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  }
                }
              },
