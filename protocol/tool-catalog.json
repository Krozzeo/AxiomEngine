      "inputSchema": {
        "type": "object",
        "properties": {
          "echo": {}
        }
      }
    },
    {
      "name": "demo.increment",
      "description": "Mutate the bounded bootstrap demo state and create an undo record.",
      "mutates": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "integer"
          }
        },
        "required": [
          "amount"
        ]
      }
    },
