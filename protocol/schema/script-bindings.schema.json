{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axiom://schema/script-bindings/v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "namespace",
    "components",
    "limits"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "namespace": {
      "type": "string"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    }
  }
}
