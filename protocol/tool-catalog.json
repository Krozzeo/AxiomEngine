        "required": [
          "id"
        ]
      }
    },
    {
      "name": "project.save",
      "description": "Atomically save a scene at the expected persisted revision. Bootstrap only; editor.undo does not revert disk saves.",
      "mutates": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0
          },
          "scene": {
            "$ref": "https://axiomengine.dev/schema/project-document-v1.json#/properties/scene"
          }
        },
        "required": [
          "id",
          "expectedRevision",
          "scene"
        ]
      }
    },
