                "required": [
                  "levels"
                ]
              },
              "parentId": {
                "type": "string",
                "pattern": "^entity://[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "sprite2D": {
                "type": "object",
                "required": [
                  "columns",
                  "rows",
                  "frame",
                  "size",
                  "tint",
                  "order",
                  "lit",
                  "flipX",
                  "flipY"
                ],
                "properties": {
                  "columns": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 64
                  },
                  "rows": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 64
                  },
                  "frame": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4095
                  },
                  "size": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "number",
                      "minimum": 0.001,
                      "maximum": 10000
                    }
                  },
                  "tint": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "order": {
                    "type": "integer",
                    "minimum": -32768,
                    "maximum": 32767
                  },
                  "lit": {
                    "type": "boolean"
                  },
                  "flipX": {
                    "type": "boolean"
                  },
                  "flipY": {
                    "type": "boolean"
                  }
                }
              },
              "spriteAnimation": {
                "type": "object",
                "required": [
                  "frames",
                  "fps",
                  "loop",
                  "autoplay"
                ],
                "properties": {
                  "frames": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 256,
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4095
                    }
                  },
                  "fps": {
                    "type": "number",
                    "minimum": 0.01,
                    "maximum": 120
                  },
                  "loop": {
                    "type": "boolean"
                  },
                  "autoplay": {
                    "type": "boolean"
                  }
                }
              },
              "tilemap": {
                "type": "object",
                "required": [
                  "assetId",
                  "columns",
                  "rows",
                  "width",
                  "height",
                  "tileSize",
                  "cells",
                  "order",
                  "lit"
                ],
                "properties": {
                  "assetId": {
                    "type": "string",
                    "pattern": "^asset://[0-9a-f]{64}$"
                  },
                  "columns": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 64
                  },
                  "rows": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 64
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 64
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 64
                  },
                  "tileSize": {
                    "type": "number",
                    "minimum": 0.001,
                    "maximum": 1000
                  },
                  "cells": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 4096,
                    "items": {
                      "type": "integer",
                      "minimum": -1,
                      "maximum": 4095
                    }
                  },
                  "order": {
                    "type": "integer",
                    "minimum": -32768,
                    "maximum": 32767
                  },
                  "lit": {
                    "type": "boolean"
                  }
                }
              },
              "light2D": {
                "type": "object",
                "required": [
                  "color",
                  "intensity",
                  "radius"
                ],
                "properties": {
                  "color": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "intensity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 8
                  },
                  "radius": {
                    "type": "number",
                    "minimum": 0.001,
                    "maximum": 10000
                  }
                }
              },
              "particles2D": {
                "type": "object",
                "required": [
                  "capacity",
                  "rate",
                  "lifetime",
                  "speed",
                  "spread",
                  "gravity",
                  "size",
                  "color",
                  "seed",
                  "order"
                ],
                "properties": {
                  "capacity": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 512
                  },
                  "rate": {
                    "type": "number",
                    "minimum": 0.01,
                    "maximum": 256
                  },
                  "lifetime": {
                    "type": "number",
                    "minimum": 0.01,
                    "maximum": 30
                  },
                  "speed": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "spread": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 360
                  },
                  "gravity": {
                    "type": "number",
                    "minimum": -100,
                    "maximum": 100
                  },
                  "size": {
                    "type": "number",
                    "minimum": 0.001,
                    "maximum": 100
                  },
                  "color": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "seed": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4294967295
                  },
                  "order": {
                    "type": "integer",
                    "minimum": -32768,
                    "maximum": 32767
                  }
                }
              },
              "ui2D": {
                "type": "object",
                "required": [
                  "kind",
                  "rect",
                  "color",
                  "order",
                  "action"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "panel",
                      "button"
                    ]
                  },
                  "rect": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "color": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "order": {
                    "type": "integer",
                    "minimum": -32768,
                    "maximum": 32767
                  },
                  "action": {
                    "enum": [
                      "none",
                      "togglePause"
                    ]
                  }
                }
              },
              "animator": {
                "type": "object",
                "required": [
                  "initialState",
                  "speed",
                  "autoplay",
                  "states",
                  "parameters",
                  "transitions"
                ],
                "properties": {
                  "initialState": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "speed": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 8
                  },
                  "autoplay": {
                    "type": "boolean"
                  },
                  "states": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 8,
                    "items": {
                      "type": "object",
                      "required": [
                        "name",
                        "clip",
                        "loop",
                        "speed"
                      ],
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        "clip": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        "loop": {
                          "type": "boolean"
                        },
                        "speed": {
                          "type": "number",
                          "minimum": 0.01,
                          "maximum": 8
                        }
                      }
                    }
                  },
                  "parameters": {
                    "type": "array",
                    "minItems": 0,
                    "maxItems": 8,
                    "items": {
                      "type": "object",
                      "required": [
                        "name",
                        "value"
                      ],
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        "value": {
                          "type": "number",
                          "minimum": -1000000.0,
                          "maximum": 1000000.0
                        }
                      }
                    }
                  },
                  "transitions": {
                    "type": "array",
                    "minItems": 0,
                    "maxItems": 16,
                    "items": {
                      "type": "object",
                      "required": [
                        "source",
                        "target",
                        "parameter",
                        "comparison",
                        "threshold",
                        "duration"
                      ],
                      "properties": {
                        "source": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        "target": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        "parameter": {
                          "type": "string",
                          "maxLength": 64
                        },
                        "comparison": {
                          "type": "string",
                          "enum": [
                            "gt",
                            "lt",
                            "eq"
                          ]
                        },
                        "threshold": {
                          "type": "number",
                          "minimum": -1000000.0,
                          "maximum": 1000000.0
                        },
                        "duration": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 5
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "assets": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^asset://[0-9a-f]{64}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "kind": {
                "enum": [
                  "sprite",
                  "mesh",
                  "audio"
                ]
              },
              "sourceId": {
                "type": "string",
                "pattern": "^asset://[0-9a-f]{64}$"
              },
              "textureId": {
                "type": "string",
                "pattern": "^asset://[0-9a-f]{64}$"
              },
              "buildKey": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "camera": {
          "type": "object",
          "required": [
            "projection",
            "position",
            "target",
            "orthoHeight",
            "fov"
          ],
          "properties": {
            "projection": {
              "enum": [
                "perspective",
                "orthographic"
              ]
            },
            "position": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              }
            },
            "target": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              }
            },
            "orthoHeight": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 10000
            },
            "fov": {
              "type": "number",
              "minimum": 5,
              "maximum": 150
            }
          }
        },
        "assetDbVersion": {
          "const": 1
        },
        "script": {
          "type": "object",
          "required": [
            "source",
            "attachments",
            "build"
          ],
          "properties": {
            "source": {
              "type": "string",
              "maxLength": 65536
            },
            "attachments": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string",
                "pattern": "^entity://[0-9a-f-]{36}$"
              }
            },
            "build": {
              "type": "object",
              "required": [
                "id",
                "sourceHash",
                "mode"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "sourceHash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "development",
                    "aot"
                  ]
                }
              }
            }
          }
        },
        "rendering": {
          "type": "object",
          "properties": {
            "tier": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "culling": {
              "type": "string",
              "enum": [
                "cpu",
                "gpu",
                "none"
              ]
            },
            "exposure": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 100
            },
            "toneMapping": {
              "type": "string",
              "enum": [
                "aces",
                "reinhard",
                "none"
              ]
            },
            "environment": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            },
            "shadows": {
              "type": "boolean"
            },
            "shadowSize": {
              "type": "number",
              "minimum": 1,
              "maximum": 100
            },
            "bloom": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "fxaa": {
              "type": "boolean"
            }
          },
          "required": [
            "tier",
            "culling",
            "exposure",
            "toneMapping",
            "environment",
            "shadows",
            "shadowSize",
            "bloom",
            "fxaa"
          ]
        },
        "twoD": {
          "type": "object",
          "required": [
            "ambient",
            "background",
            "pixelPerfect",
            "pixelsPerUnit",
            "referenceHeight"
          ],
          "properties": {
            "ambient": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "background": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "pixelPerfect": {
              "type": "boolean"
            },
            "pixelsPerUnit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 512
            },
            "referenceHeight": {
              "type": "integer",
              "minimum": 64,
              "maximum": 1080
            }
          }
        }
      }
    },
    "editor": {
      "type": "object",
      "required": [
        "leftWidth",
        "rightWidth",
        "bottomHeight"
      ],
      "properties": {
        "leftWidth": {
          "type": "number",
          "minimum": 150,
          "maximum": 600
        },
        "rightWidth": {
          "type": "number",
          "minimum": 220,
          "maximum": 700
        },
        "bottomHeight": {
          "type": "number",
          "minimum": 120,
          "maximum": 650
        }
      }
    }
  }
}
