                  "velocity": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number",
                      "minimum": -10000,
                      "maximum": 10000
                    }
                  },
                  "restitution": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "friction": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "gravityScale": {
                    "type": "number",
                    "minimum": -100,
                    "maximum": 100
                  },
                  "angularVelocity": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number",
                      "minimum": -10000,
                      "maximum": 10000
                    }
                  },
                  "freezeRotation": {
                    "type": "boolean"
                  }
                }
              },
              "material": {
                "type": "object",
                "properties": {
                  "baseColor": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "metallic": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "roughness": {
                    "type": "number",
                    "minimum": 0.045,
                    "maximum": 1
                  },
                  "emissive": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 10000
                    }
                  },
                  "alphaMode": {
                    "type": "string",
                    "enum": [
                      "opaque",
                      "mask",
                      "blend"
                    ]
                  },
                  "alphaCutoff": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "unlit": {
                    "type": "boolean"
                  },
                  "castShadow": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "baseColor",
                  "metallic",
                  "roughness",
                  "emissive",
                  "alphaMode",
                  "alphaCutoff",
                  "unlit",
                  "castShadow"
                ]
              },
              "light": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "directional",
                      "point",
                      "spot"
                    ]
                  },
                  "color": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "intensity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 10000
                  },
                  "range": {
                    "type": "number",
                    "minimum": 0.01,
                    "maximum": 10000
                  },
                  "direction": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number",
                      "minimum": -1,
                      "maximum": 1
                    }
                  },
                  "innerAngle": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 89
                  },
                  "outerAngle": {
                    "type": "number",
                    "minimum": 0.1,
                    "maximum": 89
                  },
                  "shadow": {
                    "type": "boolean"
                  }
