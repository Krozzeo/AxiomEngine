      "inputSchema": {
        "type": "object"
      }
    },
    {
      "name": "project.create",
      "description": "Create an empty persistent project. Bootstrap adapter only; not undoable.",
      "mutates": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "name"
        ]
      }
    },
    {
      "name": "project.open",
      "description": "Load a project by stable ID. Bootstrap adapter only.",
