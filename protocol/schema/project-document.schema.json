                "properties": {
                  "assetId": {
                    "type": "string",
                    "pattern": "^asset://[0-9a-f]{64}$"
                  },
                  "kind": {
                    "enum": [
                      "sprite",
                      "mesh"
                    ]
                  }
                }
              },
              "collider": {
                "type": "object",
                "required": [
                  "dimension",
                  "shape",
                  "halfExtents",
                  "trigger",
                  "layer",
                  "mask"
