                "required": [
                  "kind",
                  "color",
                  "intensity",
                  "range",
                  "direction",
                  "innerAngle",
                  "outerAngle",
                  "shadow"
                ]
              },
              "lod": {
                "type": "object",
                "properties": {
                  "levels": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 3,
                    "items": {
                      "type": "object",
                      "properties": {
                        "assetId": {
                          "type": "string",
                          "pattern": "^asset://[0-9a-f]{64}$"
                        },
                        "distance": {
                          "type": "number",
                          "minimum": 0.01,
                          "maximum": 10000
