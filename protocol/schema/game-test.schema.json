{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiomengine.dev/schema/game-test-v1.json",
  "type": "object",
  "required": [
    "name",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "frames"
        ],
        "additionalProperties": false,
        "properties": {
          "frames": {
            "type": "integer",
            "minimum": 0,
            "maximum": 120
          },
          "keys": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string",
              "pattern": "^(Key[A-Z]|Digit[0-9]|Arrow(Left|Right|Up|Down)|Space|ShiftLeft|ShiftRight)$"
            }
          },
          "assertions": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "required": [
                "kind"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "entityCount",
                    "position",
                    "rotation",
                    "collision",
                    "pixel",
                    "animation"
                  ]
                },
                "entityId": {
                  "type": "string",
                  "pattern": "^entity://[0-9a-f-]{36}$"
                },
                "otherId": {
                  "type": "string",
                  "pattern": "^entity://[0-9a-f-]{36}$"
                },
                "count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
                },
                "value": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 4,
                  "items": {
                    "type": "number",
                    "minimum": -1000000,
                    "maximum": 1000000
                  }
                },
                "tolerance": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 255
                },
                "expected": {
                  "type": "boolean"
                },
                "trigger": {
                  "type": "boolean"
                },
                "x": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 959
                },
                "y": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 539
                },
                "rgba": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  }
                },
                "state": {
                  "type": "string",
                  "maxLength": 128
                }
              }
            }
          }
        }
      }
    }
  }
}
